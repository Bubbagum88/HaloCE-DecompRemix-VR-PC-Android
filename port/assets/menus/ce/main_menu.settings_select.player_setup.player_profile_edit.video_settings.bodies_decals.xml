	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/bodies_decals/help_strings">
		<string text=""/>
		<string text="Ragdoll: bodies fall limp, thrown by what killed\nthem. Classic: the game's own death animations."/>
		<string text="Classic: dropped guns bounce, then lie flat.\nEnhanced: they tumble and roll (Jolt Physics)."/>
		<string text="Multiplayer bodies. Default: gone after 30\nseconds. Extended: they stay until the limit."/>
		<string text="How many bodies and dropped weapons stay\nabout. Default: the game's. Insane: 8x."/>
		<string text="How many bullet holes, scorch marks and blood\nstay. Insane: 12x the game's. From the next map."/>
		<string text="Default: marks fade after about 3 minutes.\nExtended: they stay until the limit is reached."/>
		<string text="Decals drawn as the Xbox drew them: the same\npicture, far less work for the processor."/>
		<string text="Classic: guns and grenades on the ground are\nsupersized in multiplayer. Enhanced: real size."/>
	</strings>
