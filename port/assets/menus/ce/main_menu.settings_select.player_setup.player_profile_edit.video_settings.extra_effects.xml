	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/extra_effects/help_strings">
		<string text=""/>
		<string text="Shields light their surroundings as they flare,\nin the shield's own color."/>
		<string text="Light Show: the shield glow three times as far,\nat full from a third of the flare."/>
		<string text="The overshield rises up the body as it charges\nand stays lit, in its own color. Off: stock."/>
		<string text="Hits throw blood on the walls behind, and it\nruns down them. Off: the game's own blood."/>
		<string text="Blood stains vehicles and objects, riding with\nthem and running down them."/>
		<string text="Bullet holes and burns on vehicles and Spartans;\nplasma sparks, smoke and light. Off: stock."/>
		<string text="Hard shadows from characters and vehicles, as\nF.E.A.R. and Doom 3 cast them. Costly on Quest."/>
	</strings>
